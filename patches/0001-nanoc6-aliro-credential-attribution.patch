+bool AliroDoorLockDelegate::ResolveLastCredentialMatch()
+{
+    nvs_handle_t handle = 0;
+    if (nvs_open_from_partition("nvs", "aliro_pkey", NVS_READONLY, &handle) != ESP_OK) {
+        return false;
+    }
+
+    bool foundIndex = false;
+    uint16_t latestIndex = 0;
+    uint32_t latestLru = 0;
+    char key[16];
+    for (uint16_t index = 0; index < kAliroFastTransactionSlots; ++index) {
+        snprintf(key, sizeof(key), "a/lru/%04x", index);
+        uint32_t lru = 0;
+        if (nvs_get_u32(handle, key, &lru) == ESP_OK && (!foundIndex || lru > latestLru)) {
+            latestLru = lru;
+            latestIndex = index;
+            foundIndex = true;
+        }
+    }
+    if (!foundIndex) {
+        nvs_close(handle);
+        return false;
+    }
+
+    snprintf(key, sizeof(key), "a/acpk/%04x", latestIndex);
+    uint8_t publicKeyDer[kAliroPublicKeyDerMax];
+    size_t publicKeyDerLen = sizeof(publicKeyDer);
+    const esp_err_t err = nvs_get_blob(handle, key, publicKeyDer, &publicKeyDerLen);
+    nvs_close(handle);
+    if (err != ESP_OK || publicKeyDerLen == 0 || publicKeyDerLen > sizeof(publicKeyDer)) {
+        return false;
+    }
+
+    DoorLockStorage::AliroMatch match;
+    if (!DoorLockStorage::Instance().FindAliroCredentialByPublicKeyDer(
+            ByteSpan(publicKeyDer, publicKeyDerLen), match)) {
+        memset(publicKeyDer, 0, sizeof(publicKeyDer));
+        return false;
+    }
+    memset(publicKeyDer, 0, sizeof(publicKeyDer));
+    m_last_credential_match = match;
+    m_has_last_credential_match = true;
+    return true;
+}
