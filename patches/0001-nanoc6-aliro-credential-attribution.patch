+bool DoorLockStorage::FindAliroCredentialByPublicKeyDer(const ByteSpan  &publicKeyDer,
+                                                        AliroMatch  &match) const
+{
+    // ANSI X9.63 uncompressed P-256 public key wrapped as X.509 SubjectPublicKeyInfo.
+    static constexpr uint8_t kP256SpkiPrefix[] = {
+        0x30, 0x59, 0x30, 0x13, 0x06, 0x07, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01,
+        0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07, 0x03, 0x42, 0x00,
+    };
+
+    VerifyOrReturnValue(mInitialized, false);
+    match = AliroMatch();
+
+    constexpr CredentialTypeEnum kEndpointTypes[] = {
+        CredentialTypeEnum::kAliroEvictableEndpointKey,
+        CredentialTypeEnum::kAliroNonEvictableEndpointKey,
+    };
+    for (CredentialTypeEnum type : kEndpointTypes) {
+        const uint16_t slotCount = mLimits.credentialSlotsByType[to_underlying(type)];
+        for (uint16_t normalizedIndex = 0; normalizedIndex < slotCount; ++normalizedIndex) {
+            const CredentialRecord  &credential =
+                mCredentials[CredentialStorageIndex(normalizedIndex, type)];
+            if (credential.status != DlCredentialStatus::kOccupied) {
+                continue;
+            }
+
+            bool keyMatches = false;
+            if (credential.dataLength == publicKeyDer.size() &&
+                    ByteSpan(credential.data, credential.dataLength).data_equal(publicKeyDer)) {
+                keyMatches = true;
+            } else if (credential.dataLength == 65 &&
+                       publicKeyDer.size() == sizeof(kP256SpkiPrefix) + credential.dataLength &&
+                       memcmp(publicKeyDer.data(), kP256SpkiPrefix, sizeof(kP256SpkiPrefix)) == 0 &&
+                       memcmp(publicKeyDer.data() + sizeof(kP256SpkiPrefix), credential.data,
+                              credential.dataLength) == 0) {
+                keyMatches = true;
+            }
+            if (!keyMatches) {
+                continue;
+            }
+
+            const uint16_t credentialIndex = normalizedIndex + 1;
+            for (uint16_t userStorageIndex = 0; userStorageIndex < mLimits.numberOfUsers;
+                 ++userStorageIndex) {
+                const UserRecord  &user = mUsers[userStorageIndex];
+                if (user.status != UserStatusEnum::kOccupiedEnabled) {
+                    continue;
+                }
+                for (uint8_t i = 0; i < user.credentialCount; ++i) {
+                    if (user.credentials[i].credentialType == type &&
+                            user.credentials[i].credentialIndex == credentialIndex) {
+                        match.userIndex = userStorageIndex + 1;
+                        match.credentialIndex = credentialIndex;
+                        match.credentialType = type;
+                        return true;
+                    }
+                }
+            }
+            return false;
+        }
+    }
+    return false;
+}
