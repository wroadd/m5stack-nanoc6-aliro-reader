diff --git a/examples/door_lock/main/network_mode.cpp b/examples/door_lock/main/network_mode.cpp
new file mode 100644
index 00000000..27b02987
--- /dev/null
+++ b/examples/door_lock/main/network_mode.cpp
@@ -0,0 +1,110 @@
+/*
+   This example code is in the Public Domain (or CC0 licensed, at your option.)
+*/
+
+#include "network_mode.h"
+
+#include <app/clusters/network-commissioning/network-commissioning.h>
+#include <esp_log.h>
+#include <nvs.h>
+
+#include <lib/support/TypeTraits.h>
+
+namespace NetworkCommissioning = chip::app::Clusters::NetworkCommissioning;
+
+namespace {
+
+constexpr char kNamespace[] = "aliro-config";
+constexpr char kModeKey[] = "net-mode";
+constexpr AppNetworkMode kDefaultMode = AppNetworkMode::kThread;
+
+AppNetworkMode s_mode = kDefaultMode;
+const char *TAG = "network_mode";
+
+bool is_valid_mode(uint8_t value)
+{
+    return value == static_cast<uint8_t>(AppNetworkMode::kThread) ||
+           value == static_cast<uint8_t>(AppNetworkMode::kWiFi);
+}
+
+} // namespace
+
+esp_err_t app_network_mode_init()
+{
+    nvs_handle_t handle;
+    esp_err_t err = nvs_open(kNamespace, NVS_READONLY, &handle);
+    if (err == ESP_ERR_NVS_NOT_FOUND) {
+        s_mode = kDefaultMode;
+        ESP_LOGI(TAG, "No saved network mode; using %s", app_network_mode_name(s_mode));
+        return ESP_OK;
+    }
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "Failed to open network-mode storage: %s", esp_err_to_name(err));
+        return err;
+    }
+
+    uint8_t stored_mode = 0;
+    err = nvs_get_u8(handle, kModeKey, &stored_mode);
+    nvs_close(handle);
+
+    if (err == ESP_ERR_NVS_NOT_FOUND || !is_valid_mode(stored_mode)) {
+        s_mode = kDefaultMode;
+        ESP_LOGW(TAG, "Saved network mode is missing or invalid; using %s", app_network_mode_name(s_mode));
+        return ESP_OK;
+    }
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "Failed to read network mode: %s", esp_err_to_name(err));
+        return err;
+    }
+
+    s_mode = static_cast<AppNetworkMode>(stored_mode);
+    ESP_LOGI(TAG, "Selected network mode: %s", app_network_mode_name(s_mode));
+    return ESP_OK;
+}
+
+AppNetworkMode app_network_mode_get()
+{
+    return s_mode;
+}
+
+const char *app_network_mode_name(AppNetworkMode mode)
+{
+    return mode == AppNetworkMode::kWiFi ? "Wi-Fi" : "Thread";
+}
+
+uint32_t app_network_mode_feature_map()
+{
+    const auto feature = s_mode == AppNetworkMode::kWiFi
+        ? NetworkCommissioning::Feature::kWiFiNetworkInterface
+        : NetworkCommissioning::Feature::kThreadNetworkInterface;
+    return chip::to_underlying(feature);
+}
+
+esp_err_t app_network_mode_set(AppNetworkMode mode)
+{
+    nvs_handle_t handle;
+    esp_err_t err = nvs_open(kNamespace, NVS_READWRITE, &handle);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "Failed to open network-mode storage for writing: %s", esp_err_to_name(err));
+        return err;
+    }
+
+    err = nvs_set_u8(handle, kModeKey, static_cast<uint8_t>(mode));
+    if (err == ESP_OK) {
+        err = nvs_commit(handle);
+    }
+    nvs_close(handle);
+
+    if (err == ESP_OK) {
+        s_mode = mode;
+        ESP_LOGI(TAG, "Saved network mode: %s", app_network_mode_name(s_mode));
+    } else {
+        ESP_LOGE(TAG, "Failed to save network mode: %s", esp_err_to_name(err));
+    }
+    return err;
+}
+
+esp_err_t app_network_mode_toggle()
+{
+    return app_network_mode_set(s_mode == AppNetworkMode::kThread ? AppNetworkMode::kWiFi : AppNetworkMode::kThread);
+}
